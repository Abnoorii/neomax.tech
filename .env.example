# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key

# OpenAI (Whisper)
OPENAI_API_KEY=your_openai_api_key

# Twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# NEOMAX marketing site
# ---------------------------------------------------------------------------

# Canonical production origin. Used for canonicals, Open Graph URLs, sitemap.
NEXT_PUBLIC_SITE_URL=https://neomax.tech

# Content gating: "demo" renders unverified content behind visible "Illustrative"
# labels; "verified-only" removes it from the site entirely.
NEXT_PUBLIC_CONTENT_MODE=demo

# Public contact details. Placeholders are used until these are set.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_BOOKING_URL=

# Enquiry delivery (see lib/site/enquiry-delivery.ts). Until both are set the
# contact form validates but tells the visitor it was not sent.
ENQUIRY_PROVIDER_API_KEY=
ENQUIRY_FROM_EMAIL=
ENQUIRY_TO_EMAIL=
